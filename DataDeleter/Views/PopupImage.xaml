<Window x:Class="DataDeleter.Views.PopupImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataDeleter.Views"
        mc:Ignorable="d"
        Title="PopupImage" Height="450" Width="800">

    <Window.Resources>
        <!-- Import the built-in WPF converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Display the Image -->
        <Image Source="{Binding ImageSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Error Message overlay if file load fails -->
        <TextBlock Text="{Binding ErrorMessage}" 
                   Foreground="Red" 
                   FontSize="14" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>

        <Button Content="Close" Grid.Row="1" Width="80" Height="30" Margin="0,10,0,0" 
                HorizontalAlignment="Right" IsCancel="True" Click="CloseButton_Click"/>
    </Grid>
</Window>
