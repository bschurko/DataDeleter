<Window x:Class="DataDeleter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataDeleter"
        xmlns:vm="clr-namespace:DataDeleter.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <!--
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
-->
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="400*"/>
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Left" Margin="86,6,0,0" TextWrapping="Wrap" Text="From Date:" VerticalAlignment="Top" Grid.Column="1" Height="16" Width="70"/>
        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="70,27,0,0" VerticalAlignment="Top" Height="27" Width="114"/>
        <TextBlock HorizontalAlignment="Left" Margin="268,4,0,0" TextWrapping="Wrap" Text="To Date:" VerticalAlignment="Top" Width="52" Grid.Column="1" Height="18"/>
        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="243,27,0,0" VerticalAlignment="Top" Height="27" Width="110"/>
        <DataGrid ItemsSource="{Binding ScannedFiles}"
            SelectedItem="{Binding SelectedScannedFile, Mode=TwoWay}"
            Margin="0,85,0,71" HorizontalAlignment="Center" Width="780">
        </DataGrid>
        <Button Content="Delete Files" HorizontalAlignment="Left" Margin="596,421,0,0" VerticalAlignment="Top" Height="35" Width="79"/>
        <Button Command="{Binding ScanFilesCommand}" Content="Scan" HorizontalAlignment="Left" Margin="699,421,0,0" VerticalAlignment="Top" Height="35" Width="77"/>
        <Button Command="{Binding AddExtensionCommand}" Content="Add Extension" HorizontalAlignment="Left" Margin="424,38,0,0" VerticalAlignment="Top" Height="32" Width="92"/>
        <Button Command="{Binding SelectDirectoryPathCommand}" Content="Select Directory" HorizontalAlignment="Left" Margin="327,422,0,0" VerticalAlignment="Top" Height="34" Width="105"/>
        <ListView ItemsSource="{Binding Extensions}"
                  SelectedValue="{Binding SelectedExtension, Mode=TwoWay}"
                  Margin="531,10,35,404">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding .}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox
            Text="{Binding ExtensionValue, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="424,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="92" Height="23"/>
        <TextBox IsEnabled="False"
            Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="25,422,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="269" Height="34"/>

    </Grid>
</Window>
